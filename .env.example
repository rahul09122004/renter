# ══ Copy to .env for LOCAL development. NEVER commit .env. ══════════════════════
# In production set these as real environment variables in your host's dashboard.

# ── Core ────────────────────────────────────────────────────────────────────────
# production (default, strict) | development (relaxed cookies/HTTPS, seeds demo data)
APP_ENV=development
# REQUIRED in production, >= 32 random chars. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Only used to create the very first admin. Leave blank to get a random one-time
# password printed in the log. Weak/known passwords are rejected.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Seed fake demo tenants (dev only; never in production — fake numbers can get real messages)
SEED_DEMO_DATA=false

# ── Database ────────────────────────────────────────────────────────────────────
# Blank = local SQLite. PostgreSQL: postgresql://user:pass@host:5432/dbname
# TLS is added automatically for non-local hosts (override: DB_SSLMODE=disable).
DATABASE_URL=

# ── Accounts / sign-up ──────────────────────────────────────────────────────────
# closed (default in production) | invite | open
SIGNUP_MODE=open
SIGNUP_INVITE_CODE=
REQUIRE_EMAIL_VERIFICATION=true
# Public https URL of the site — used to build links in emails.
PUBLIC_BASE_URL=
SESSION_LIFETIME_HOURS=8
SESSION_IDLE_MINUTES=60

# ── Email (verification + password reset). In development without SMTP the link
#    is printed to the console instead. ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Deployment behind a proxy (Render/Heroku/nginx) ─────────────────────────────
# Number of reverse proxies in front of the app (1 on Render). 0 for direct/local.
TRUSTED_PROXIES=0
# Shared rate-limit storage for multi-worker setups, e.g. redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# ── Integrations (all optional) ─────────────────────────────────────────────────
ACCESS_TOKEN=            # WhatsApp Cloud API
PHONE_NUMBER_ID=
FAST2SMS_KEY=
OCRSPACE_API_KEY=        # payment-screenshot OCR (get your own; don't rely on the shared demo key)
# Supabase Storage (private bucket + signed URLs). Use the SERVER-SIDE service key only.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=uploads

PORT=5000
